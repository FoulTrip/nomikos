{
  "name": "nomikos-demo-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "repomix": "repomix --config repomix.config.json",
    "generate:script": "python3 scripts/generate-script.py",
    "generate:tts": "python3 scripts/generate-tts.py",
    "preview": "remotion preview",
    "render:16x9": "remotion render HackathonDemo out/demo_16x9.mp4 --props=src/config/data.json",
    "render:9x16": "remotion render HackathonShort out/demo_9x16.mp4 --props=src/config/data.json",
    "render:hero": "remotion render HeroCheck out/hero-check.mp4",
    "render:ambient": "remotion render AmbientLoop out/ambient_16x9.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@remotion/cli": "4.0.538",
    "@remotion/effects": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "@remotion/layout-utils": "4.0.538",
    "@remotion/media-utils": "4.0.538",
    "@remotion/paths": "4.0.538",
    "@remotion/shapes": "4.0.538",
    "@remotion/three": "4.0.538",
    "@types/three": "^0.170.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.538",
    "three": "^0.170.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}

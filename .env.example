# NomikOS — plantilla central del monorepo. No guardes secretos reales aquí.
# Inicio Docker: bash scripts/nomikos.sh up (Linux) o
# powershell -NoProfile -ExecutionPolicy Bypass -File .\scripts\nomikos.ps1 up.
# El lanzador crea .env y secretos.
# R2 es opcional: RustFS local sirve y publica el GLB sin credenciales externas.

# API — Rust, fuente única de verdad
AGENT_OS_API_HOST=127.0.0.1
AGENT_OS_API_PORT=8080
AGENT_OS_API_DB_PATH=data/agent-os.db
SYNC_INTERVAL_SECS=10
PAYLOAD_URL=http://localhost:3100
MEDUSA_MCP_URL=https://cloud.medusajs.com/mcp
MEDUSA_MCP_TOKEN=
SOLANA_NETWORK=devnet
SOLANA_LOCAL_URL=http://localhost:8899
SOLANA_DEVNET_URL=https://api.devnet.solana.com
SOLANA_TESTNET_URL=https://api.testnet.solana.com
SOLANA_MAINNET_URL=https://api.mainnet.solana.com
SOLANA_WALLET=
SOLANA_PAYER_KEYPAIR=
X402_PAYEE_WALLET=
X402_SETTLE_INTERVAL_SECS=15
X402_MAX_VERIFY_ATTEMPTS=10
DEVICE_NAME=ESP32-S3-Touch-AMOLED-1.43
DEVICE_MODEL_FILE=
# Docker local uses RustFS automatically. Set to r2 only in deployments with R2 credentials below.
OBJECT_STORE_BACKEND=local
# The launcher activates the local Compose profile from this selector.
OBJECT_STORE_MODEL_KEY=models/ESP32-S3-Touch-AMOLED-1.43.glb
# Required only when OBJECT_STORE_BACKEND=r2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=
R2_API_TOKEN=
R2_PUBLIC_URL_BASE=
ACCOUNTS_MASTER_KEY=
X402_PROTECTED_PATHS=
X402_PATH_LAMPORTS=1000
PAYLOAD_EMAIL=
PAYLOAD_PASSWORD=
BRAIN_URL=http://localhost:8322
X402_APP_LAMPORTS=1000
NVIDIA_API_KEY=
PAYLOAD_TOKEN=
VERIFIER_ENABLED=1
VERIFIER_GT_DIR=../ground_truth
VERIFIER_CASES_DIR=../cases
VERIFIER_UI_PORT=8765
VERIFIER_WORLD_TOKEN=

# Brain — shield NIM y gateway agéntico
AGENT_OS_API_URL=http://localhost:8080/api
# NVIDIA_API_KEY abastece la configuración de modelos de la cuenta en el panel.
# GUARD_API_KEY reutiliza esa clave por defecto; cambia GUARD_* si usas otro proveedor.
GUARD_PROVIDER=nvidia-nim
GUARD_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
GUARD_API_KEY=${NVIDIA_API_KEY}
GUARD_MODEL=meta/llama-guard-4-12b
MUSE_BIN=
GUARD_ENABLED=true
GUARD_EXCLUDED_CATEGORIES=S6,S7,S8,S9,S14
MAX_TOOL_ITERATIONS=8

# Dapp — Next.js
API_GATEWAY_URL=http://localhost:8080/api
AUTH_SECRET=

# Payload / Worker
PAYLOAD_SECRET=

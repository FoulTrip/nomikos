# ═══════════════════════════════════════════════════════════════════
# NomikOS — .env.example (plantilla del .env CENTRAL del monorepo)
#
#   cp .env.example .env      # y llena lo que uses
#   make secrets              # genera los secretos que falten (openssl)
#   make up                   # sincroniza a api/brain/dapp y prende todo
#
# Reglas del sync (`make env`):
#   · cada proyecto recibe SU .env.example como base
#   · las claves de aquí que estén VACÍAS no se escriben → el proyecto
#     usa el default de su propio */.env.example
#   · las claves con valor pisan el default del proyecto
#   · claves nuevas de un proyecto: agrégalas también a su */.env.example
#
# NUNCA pongas valores reales en ESTE archivo (se versiona).
# ═══════════════════════════════════════════════════════════════════

# ── SECRETOS (genéralos: `make secrets`) ─────────────────────────────
# Cifra keypairs/api_keys de cuentas en reposo (32 B base64)
ACCOUNTS_MASTER_KEY=
# Cookie de sesión Auth.js del dapp (32 B base64)
AUTH_SECRET=
# JWT secret del Payload CMS local (hex 32)
PAYLOAD_SECRET=
# Key de NVIDIA NIM: LLM de las CUENTAS + Llama Stack (:8321)
NVIDIA_API_KEY=

# ── api (:8080 — fuente única de verdad) ─────────────────────────────
#AGENT_OS_API_HOST=127.0.0.1
#AGENT_OS_API_PORT=8080
#AGENT_OS_API_DB_PATH=data/agent-os.db
#SYNC_INTERVAL_SECS=10
# La APP del ecosistema (a la que el agente paga peaje por petición)
#PAYLOAD_URL=http://localhost:3100
# Login automático de la app (o PAYLOAD_TOKEN fijo)
PAYLOAD_EMAIL=
PAYLOAD_PASSWORD=
#PAYLOAD_TOKEN=
# Orquestador (POST /api/voice → {BRAIN_URL}/v1/agentic-gateway)
#BRAIN_URL=http://localhost:8322
# ── x402 ── (peajes en lamports; rutas protegidas por matching exacto)
#X402_PROTECTED_PATHS=
#X402_PATH_LAMPORTS=1000
#X402_APP_LAMPORTS=1000
#X402_CALL_LAMPORTS=
#X402_PAYEE_WALLET=
#X402_SETTLE_INTERVAL_SECS=15
#X402_MAX_VERIFY_ATTEMPTS=10
# ── faucet Devnet (W6 — settlement real) ──
#FAUCET_ENABLED=1
#FAUCET_KEYPAIR=scripts/faucet/nomikos-treasury.json
#FAUCET_LAMPORTS=50000000
# ── Solana ──
#SOLANA_NETWORK=devnet
#SOLANA_LOCAL_URL=http://localhost:8899
#SOLANA_DEVNET_URL=https://api.devnet.solana.com
#SOLANA_TESTNET_URL=https://api.testnet.solana.com
#SOLANA_MAINNET_URL=https://api.mainnet.solana.com
# Wallet cuyo balance se sincroniza (pubkey base58 o ruta al keypair JSON)
SOLANA_WALLET=
# Keypair global para pagos salientes del sistema (vacío = solo verificación)
SOLANA_PAYER_KEYPAIR=
# ── Dispositivo + Cloudflare R2 (modelo 3D del simulador) ──
#DEVICE_NAME=ESP32-S3-Touch-AMOLED-1.43
#DEVICE_MODEL_FILE=../dapp/public/models/ESP32-S3-Touch-AMOLED-1.43.glb
#R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
#R2_BUCKET=
#R2_MODEL_KEY=models/ESP32-S3-Touch-AMOLED-1.43.glb
#R2_PUBLIC_URL_BASE=
#CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
CLOUDFLARE_API_TOKEN=
# ── Medusa MCP (opcional — ERP externo por MCP) ──
#MEDUSA_MCP_URL=https://cloud.medusajs.com/mcp
MEDUSA_MCP_TOKEN=

# ── brain (:8322 — orquestador) ──────────────────────────────────────
#AGENT_OS_API_URL=http://localhost:8080/api
# Llama Stack (:8321). Con key NIM viva: LLM_MODEL=nvidia/meta/muse-glimmer-30b
# y arráncalo con `make up` (o brain/scripts/stack-up.sh).
#LLAMA_STACK_URL=http://localhost:8321/v1
#LLAMA_STACK_API_KEY=fake
#LLM_MODEL=nvidia/meta/muse-glimmer-30b
#OLLAMA_URL=http://localhost:11434
# ── shields Llama Guard 3 ──
#GUARD_ENABLED=true
#LLAMA_GUARD_MODEL=llama-guard3:1b
#GUARD_VIA_LLAMA_STACK=false
#GUARD_EXCLUDED_CATEGORIES=S6,S7,S8,S9,S14
#MAX_TOOL_ITERATIONS=8
# Muse CLI opcional (tool ask_muse)
MUSE_BIN=

# ── dapp (:3000 — panel local; NUNCA va a la placa) ──────────────────
#API_GATEWAY_URL=http://localhost:8080/api
#BRAIN_URL=http://localhost:8322

# ── verificador legal S2 (workshop (casos nativos)) ──────────────
# Solo api lee el ground truth (0600). Brain/dapp/ui jamás.
#VERIFIER_ENABLED=1
#VERIFIER_GT_DIR=../ground_truth
#VERIFIER_CASES_DIR=../cases
#VERIFIER_UI_PORT=8765
# Token para inyectar eventos world/ sin sesión (vacío = solo Bearer cuenta)
#VERIFIER_WORLD_TOKEN=

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 56
  }
}

direction: down

# ───────── Estilos ─────────
classes: {
  capa_slate: {
    style: {
      fill: "#F1F5F9"
      stroke: "#CBD5E1"
      border-radius: 12
      font-size: 20
      bold: true
      font-color: "#0F172A"
      shadow: false
    }
  }
  capa_azul: {
    style: {
      fill: "#EFF6FF"
      stroke: "#BFDBFE"
      border-radius: 12
      font-size: 20
      bold: true
      font-color: "#1E3A8A"
      shadow: false
    }
  }
  capa_teal: {
    style: {
      fill: "#F0FDFA"
      stroke: "#99F6E4"
      border-radius: 12
      font-size: 20
      bold: true
      font-color: "#115E59"
      shadow: false
    }
  }
  capa_ambar: {
    style: {
      fill: "#FFFBEB"
      stroke: "#FDE68A"
      border-radius: 12
      font-size: 20
      bold: true
      font-color: "#92400E"
      shadow: false
    }
  }
  capa_violeta: {
    style: {
      fill: "#F5F3FF"
      stroke: "#DDD6FE"
      border-radius: 12
      font-size: 20
      bold: true
      font-color: "#4C1D95"
      shadow: false
    }
  }
  capa_rosa: {
    style: {
      fill: "#FFF1F2"
      stroke: "#FECDD3"
      border-radius: 12
      font-size: 20
      bold: true
      font-color: "#881337"
      shadow: false
    }
  }

  nodo: {
    shape: rectangle
    width: 220
    height: 90
    style: {
      fill: "#FFFFFF"
      stroke: "#475569"
      stroke-width: 2
      border-radius: 8
      font-size: 15
      font-color: "#0F172A"
      shadow: false
    }
  }
  nodo_azul: {
    shape: rectangle
    width: 220
    height: 90
    style: {
      fill: "#FFFFFF"
      stroke: "#1E40AF"
      stroke-width: 2
      border-radius: 8
      font-size: 15
      font-color: "#0F172A"
      shadow: false
    }
  }
  nodo_teal: {
    shape: rectangle
    width: 220
    height: 90
    style: {
      fill: "#FFFFFF"
      stroke: "#0F766E"
      stroke-width: 2
      border-radius: 8
      font-size: 15
      font-color: "#0F172A"
      shadow: false
    }
  }
  nodo_ambar: {
    shape: rectangle
    width: 220
    height: 90
    style: {
      fill: "#FFFFFF"
      stroke: "#B45309"
      stroke-width: 2
      border-radius: 8
      font-size: 15
      font-color: "#0F172A"
      shadow: false
    }
  }
  nodo_violeta: {
    shape: rectangle
    width: 220
    height: 90
    style: {
      fill: "#FFFFFF"
      stroke: "#5B21B6"
      stroke-width: 2
      border-radius: 8
      font-size: 15
      font-color: "#0F172A"
      shadow: false
    }
  }
  nodo_rosa: {
    shape: rectangle
    width: 220
    height: 90
    style: {
      fill: "#FFFFFF"
      stroke: "#BE123C"
      stroke-width: 2
      border-radius: 8
      font-size: 15
      font-color: "#0F172A"
      shadow: false
    }
  }

  f_voz: {
    style: {
      stroke: "#475569"
      stroke-width: 2
      font-size: 13
      font-color: "#334155"
      bold: true
    }
  }
  f_pago: {
    style: {
      stroke: "#1E40AF"
      stroke-width: 2
      font-size: 13
      font-color: "#1E3A8A"
      bold: true
    }
  }
  f_flota: {
    style: {
      stroke: "#0F766E"
      stroke-width: 2
      font-size: 13
      font-color: "#115E59"
      bold: true
    }
  }
  f_call: {
    style: {
      stroke: "#B45309"
      stroke-width: 2
      font-size: 13
      font-color: "#92400E"
      bold: true
    }
  }
  f_dapp: {
    style: {
      stroke: "#5B21B6"
      stroke-width: 2
      stroke-dash: 3
      font-size: 13
      font-color: "#4C1D95"
      bold: true
    }
  }
  f_legal: {
    style: {
      stroke: "#BE123C"
      stroke-width: 2
      font-size: 13
      font-color: "#881337"
      bold: true
    }
  }
  f_base: {
    style: {
      stroke: "#94A3B8"
      stroke-width: 1
      font-size: 12
      font-color: "#64748B"
    }
  }
}

# ───────── 1 · Personas y dispositivos ─────────
Personas: "👥 1 · Personas y dispositivos" {
  class: capa_slate

  Usuario: "👤 Usuario\nHabla y gestiona" { class: nodo }
  Dispositivo: "📟 Dispositivo NomikOS\nMicrófono y altavoz" { class: nodo }
  Panel: "🖥️ Panel web\nCuenta y dispositivos" { class: nodo }
}

# ───────── 2 · Plataforma ─────────
Plataforma: "☁️ 2 · Plataforma Nomik" {
  class: capa_azul

  Cuentas: "🔑 Cuentas\nLogin e identidad" { class: nodo_azul }
  Voz: "🎙️ Voz\nRecibe y responde" { class: nodo_azul }
  Flota: "📡 Flota\nRegistro y estado" { class: nodo_azul }
}

# ───────── 3 · Asistente IA ─────────
IA: "🤖 3 · Asistente IA" {
  class: capa_teal

  Asistente: "🤖 Asistente\nDecide y ejecuta" { class: nodo_teal }
  Modelo: "🧠 Modelo de lenguaje\nEntiende y razona" { class: nodo_teal }
  Filtro: "🛡️ Filtros in/out\nBloquean lo inseguro" { class: nodo_teal }
}

# ───────── 4 · Taller legal S1+S2 ─────────
Legal: "⚖️ 4 · Taller legal S1+S2" {
  class: capa_rosa

  S1: "📝 Agente S1\nLee casos y borra" { class: nodo_rosa }
  Casos: "📂 Casos\nDocs visibles" { class: nodo_rosa }
  Verificador: "⚖️ Verificador\nReglas estrictas" { class: nodo_rosa }
  Verdad: "🔒 Verdad\nSolo el verificador" { class: nodo_rosa }
  Mundo: "🌍 Mundo\nNueva evidencia" { class: nodo_rosa }
  Consola: "🖥️ Consola :8765\nTurnos y firma" { class: nodo_rosa }
}

# ───────── 5 · Acceso y pagos ─────────
Pagos: "💳 5 · Acceso y pagos" {
  class: capa_ambar

  Acceso: "🔒 Control de acceso\nExige y verifica el pago" { class: nodo_ambar }
  Billetera: "👛 Billetera\nFirma los pagos" { class: nodo_ambar }
  Blockchain: "⛓️ Blockchain Solana\nConfirma el pago" { class: nodo_ambar }
  Historial: "🗄️ Historial\nUn solo uso · replay 409" { class: nodo_ambar }
  Grifo: "💧 Grifo Devnet\nFondea billeteras" { class: nodo_ambar }
}

# ───────── 6 · Ecosistema de dApps ─────────
Dapps: "🧩 6 · Ecosistema de dApps" {
  class: capa_violeta

  Payload: "🗂️ Payload CMS\nGestión de contenido" { class: nodo_violeta }
  Llamadas: "📞 Llamadas\nCobro por minuto" { class: nodo_violeta }
  Nuevas: "➕ Nuevas dApps\nSe conectan al mismo acceso" { class: nodo_violeta }
}

# ───────── Relaciones internas ─────────
IA.Asistente <-> IA.Modelo: "razona" { class: f_base }
IA.Asistente <-> IA.Filtro: "revisa\nentrada y salida" { class: f_base }
Pagos.Blockchain -> Pagos.Historial: "guarda" { class: f_base }
Pagos.Billetera -> Pagos.Blockchain: "firma y envía" { class: f_base }
Pagos.Acceso -> Pagos.Billetera: "factura" { class: f_base }
Pagos.Grifo -> Pagos.Billetera: "fondea" { class: f_base }
Legal.S1 -> Legal.Casos: "lee" { class: f_base }
Legal.Verificador -> Legal.Verdad: "contrasta" { class: f_base }
Legal.Mundo -> Legal.Verificador: "inyecta" { class: f_base }
Legal.Consola -> Legal.Verificador: "lee y firma" { class: f_base }

# ───────── A · Voz ─────────
Personas.Usuario -> Personas.Dispositivo: "A1 · habla" { class: f_voz }
Personas.Dispositivo <-> Plataforma.Voz: "A2 · envía\nA5 · responde" { class: f_voz }
Plataforma.Voz <-> IA.Asistente: "A3 · consulta\nA4 · respuesta" { class: f_voz }

# ───────── B · Servicio con pago ─────────
IA.Asistente <-> Pagos.Acceso: "B1 · pide servicio\nB2 · 402 + factura" { class: f_pago }
IA.Asistente <-> Pagos.Billetera: "B3 · firma" { class: f_pago }
Pagos.Acceso -> Dapps.Payload: "B4 · entrega" { class: f_pago }
Pagos.Acceso -> Pagos.Blockchain: "B5 · registra pago" { class: f_pago }

# ───────── C · Registro de dispositivo ─────────
Personas.Dispositivo <-> Plataforma.Flota: "C1 · pide\nC3 · activo" { class: f_flota }
Personas.Panel -> Plataforma.Flota: "C2 · código" { class: f_flota }

# ───────── D · Llamadas ─────────
Pagos.Acceso -> Dapps.Llamadas: "D1 · inicia\npor minuto" { class: f_call }

# ───────── Futuro ─────────
Pagos.Acceso -> Dapps.Nuevas { class: f_dapp }

# ───────── E · Panel ─────────
Personas.Panel -> Plataforma.Cuentas: "E1 · inicia sesión" { class: f_base }
IA.Asistente -> Plataforma.Cuentas: "verifica identidad" { class: f_base }

# ───────── F · Caso legal S1 ─────────
Legal.S1 -> IA.Asistente: "F1 · borrador" { class: f_legal }
IA.Asistente -> Legal.Casos: "F2 · lee docs" { class: f_legal }
IA.Asistente <-> Legal.Verificador: "F3 · entrega\nG3 · pasa o frena" { class: f_legal }

# ───────── G · Verificación S2 ─────────
Personas.Usuario -> Legal.Consola: "G1 · revisa y firma" { class: f_legal }
Legal.Mundo -> IA.Asistente: "G2 · evidencia" { class: f_legal }
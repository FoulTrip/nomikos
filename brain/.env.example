# ── agent-os-api (fuente única de verdad) ─────────────────────────────
AGENT_OS_API_URL=http://localhost:8080/api

# ── Llama Stack (LEGACY — ya nada lo usa) ─────────────────────────────
# El razonamiento es 100% de la cuenta (sus keys en Modelos del agente);
# estas vars quedan solo por compatibilidad histórica. Si self-hosteas un
# stack, apúntalo como provider custom de TU cuenta, no aquí.
#LLAMA_STACK_URL=http://localhost:8321/v1
#LLAMA_STACK_API_KEY=fake
#LLM_MODEL=llama3.2:3b

# Ollama: SOLO shields Llama Guard (nunca razona). Servir en CPU si la
# iGPU se queda sin VRAM: VK_ICD_FILENAMES=/dev/null OLLAMA_NUM_GPU=0
OLLAMA_URL=http://localhost:11434

# ── Llama Guard 3 (shields in/out) ────────────────────────────────────
GUARD_ENABLED=true
LLAMA_GUARD_MODEL=llama-guard3:1b
# true → usa la moderation API de Llama Stack; false → Ollama directo
GUARD_VIA_LLAMA_STACK=false
# S7 excluido: el agente solo reporta datos DE LA PROPIA cuenta a su dueño
# (falsos positivos del 1B con pubkeys/IDs — ver config.py)
GUARD_EXCLUDED_CATEGORIES=S6,S7,S8,S9,S14

# ── x402: handshake reactivo — el gateway de la API manda (402 →
#    pago delegado de la cuenta → reintento con X-Payment). Sin config aquí.
# true → cada tool protegida: invoice → POST /api/x402/pay (firma con
#        SOLANA_PAYER_KEYPAIR de agent-os-api) → verify → ejecutar
# Tools que requieren peaje (separadas por coma; vacío = ninguna)

# ── Límites del orquestador ───────────────────────────────────────────
MAX_TOOL_ITERATIONS=8

# ── NVIDIA NIM ───────────────────────────────────────────────────────
# Key de las cuentas (provider nvidia-nim) y de Llama Stack (NIM real).
# Con key viva: LLM_MODEL=nvidia/meta/muse-glimmer-30b + ./scripts/stack-up.sh
NVIDIA_API_KEY=

# ── Muse CLI (opcional — tool ask_muse) ──────────────────────────────
MUSE_BIN=

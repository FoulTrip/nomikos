# API Gateway (agent-os-api) — única fuente para ERP, modelo 3D y Solana.
API_GATEWAY_URL=http://localhost:8080/api
# Cookie de sesión Auth.js v5 (openssl rand -base64 32) — se define en
# el .env central de la raíz; el sync lo trae.
AUTH_SECRET=
# Gateway agéntico (brain) — el dapp adjunta el Bearer de la sesión.
BRAIN_URL=http://localhost:8322

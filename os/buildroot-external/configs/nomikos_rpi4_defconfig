# NomikOS — Raspberry Pi 4 (aarch64) · agente del ecosistema con x402
# Cargar con:  make nomikos_rpi4_defconfig
# (reconoce el prefijo nomikos_ gracias a BR2_EXTERNAL ../nomikos/buildroot-external)
#
# Linux liviano: kernel rpi + systemd + agentd (Rust) + dropbear. Sin
# entorno gráfico: ~el 70 % del tiempo de build es el kernel+toolchain.

# ── Toolchain / arquitectura ────────────────────────────────────────
BR2_aarch64=y
BR2_cortex_a72=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# headers del toolchain fijados a la familia del kernel (rpi-6.6.y).
# (headers-as-kernel NO sirve con toolchain interno: glibc necesita
# headers antes de que exista el árbol del kernel.)
BR2_KERNEL_HEADERS_6_6=y

# ── Init: systemd (systemd-networkd + resolved en el overlay) ──────
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y
BR2_TARGET_GENERIC_GETTY_PORT="tty1"

# ── NomikOS: el agente + overlay (agentd.service, red, config) ──────
BR2_PACKAGE_AGENTD=y
# ── Voz (NomikOS W1): STT local en la placa; piper + modelos llegan
#    por post-build (binarios fijados por sha256). TTS es piper. ──────
BR2_PACKAGE_WHISPER_CPP=y
BR2_PACKAGE_RNG_TOOLS=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_NOMIKOS_PATH)/board/rpi4/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_NOMIKOS_PATH)/board/rpi4/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_NOMIKOS_PATH)/board/rpi4/post-image.sh"

# ── Kernel Raspberry Pi (rama LTS de raspberry) ──────────────────────
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/raspberrypi/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="rpi-6.6.y"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2711-rpi-4-b broadcom/bcm2711-rpi-400 broadcom/bcm2711-rpi-cm4"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# ── Sistema base liviano ────────────────────────────────────────────
BR2_TARGET_GENERIC_ROOT_PASSWD="nomikos"
BR2_SYSTEM_BIN_SH_BASH=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_UTIL_LINUX_LOGGER=y
# CLI nomikos (tienda de apps en consola: python3 para parsear JSON)
BR2_PACKAGE_PYTHON3=y

# ── Voz (NomikOS Fase 5): SIP client para las llamadas del agente ────
# El agente (place_call) abre la sesión en el api con peaje x402/min;
# baresip lleva el audio RTP contra el trunk SIP configurado en
# /etc/baresip/accounts (requiere audio USB/HAT en la placa).
# ── Llamadas: el puente SIP (W4) vive en agentd (AGENTD_SIP_CMD);
# baresip NO está en buildroot 2026.11 (paquete removido upstream) —
# cualquier binario SIP en pipe mode sirve; empaquetarlo queda
# documentado como TODO en nomikos/README.md.
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y

# ── Imagen: rootfs ext4 + microSD completa ──────────────────────────
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
# rootfs ampliado: la voz añade ~240 MB (ggml-base + piper + voz es_ES)
BR2_TARGET_ROOTFS_EXT2_SIZE="1024M"
BR2_PACKAGE_HOST_GENIMAGE=y
# genimage crea boot.vfat con mkdosfs (dosfstools) + mtools
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y

# ── OTA (swupdate): estructura lista en swupdate/; activar cuando se
#    valide el bundle en hardware (engorda el primer build):
# BR2_PACKAGE_SWUPDATE=y
# BR2_PACKAGE_SWUPDATE_CONFIG="$(BR2_EXTERNAL_NOMIKOS_PATH)/swupdate/swupdate.config"

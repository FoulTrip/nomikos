# ================================================================
# agent-os-api — variables de entorno
# ================================================================
# Flujo implementado:
#
#   ┌──► [ Módulo Salud / ERP Avanzado (Kodetap API → Medusa.js) ]
#   │
# [ Agente (MCP / Muse) ] ──► [ Rust API ]
#   │
#   └──► [ Módulo x402 Solana ] (liquida micro-peajes en background)
#
# (El módulo multimedia Spotify/MPD se omitió por diseño.)

# ---------------- Servidor ----------------
AGENT_OS_API_HOST=127.0.0.1
AGENT_OS_API_PORT=8080
AGENT_OS_API_DB_PATH=data/agent-os.db
# Cada cuántos segundos la DB se sincroniza con el estado real
# (health de Medusa + RPC de Solana).
SYNC_INTERVAL_SECS=10

# ---------------- [ Módulo ERP / Kodetap → Payload CMS ] ----------------
# Servidor Payload CMS ya corriendo (se consulta {PAYLOAD_URL}/api/users).
PAYLOAD_URL=http://localhost:3000

# ---------------- [ Módulo Medusa MCP ] ----------------
# Servidor MCP remoto (Streamable HTTP) de Medusa Cloud:
# https://cloud.medusajs.com/mcp  (OAuth — lee el README para conectar).
MEDUSA_MCP_URL=https://cloud.medusajs.com/mcp
# Token Bearer opcional si ya tienes uno tras autorizar desde un cliente MCP
# (opencode mcp auth / claude mcp add ...). Vacío = se requiere OAuth interactivo.
MEDUSA_MCP_TOKEN=

# ---------------- [ Módulo x402 Solana ] ----------------
# Red por defecto del selector: local | devnet | testnet | mainnet
SOLANA_NETWORK=devnet
SOLANA_LOCAL_URL=http://localhost:8899
SOLANA_DEVNET_URL=https://api.devnet.solana.com
SOLANA_TESTNET_URL=https://api.testnet.solana.com
SOLANA_MAINNET_URL=https://api.mainnet.solana.com
# Wallet cuyo balance se sincroniza a la DB (pubkey base58 o ruta al
# keypair JSON). Vacío = la del CLI local (~/.config/solana).
SOLANA_WALLET=

# Liquidación x402 en background:
SOLANA_PAYER_KEYPAIR=
#   ↑ ruta a un keypair JSON con fondos para PAGAR micro-peajes
#     salientes. Vacío = solo se liquidan facturas entrantes
#     (verificación on-chain), sin mover fondos propios.
X402_PAYEE_WALLET=
#   ↑ cobrador de los micro-peajes entrantes. Vacío = SOLANA_WALLET
#     (o la del CLI local).
X402_SETTLE_INTERVAL_SECS=15
X402_MAX_VERIFY_ATTEMPTS=10

# ---------------- [ Dispositivo + Cloudflare R2 ] ----------------
DEVICE_NAME=ESP32-S3-Touch-AMOLED-1.43
# Archivo local del modelo 3D (para subirlo al bucket y servirse
# desde la API hacia agent-dapp).
DEVICE_MODEL_FILE=../agent-dapp/public/models/ESP32-S3-Touch-AMOLED-1.43.glb

# R2 es S3-compatible: endpoint https://{ACCOUNT_ID}.r2.cloudflarestorage.com
# (dash.cloudflare.com → R2 → Manage API Tokens).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_MODEL_KEY=models/ESP32-S3-Touch-AMOLED-1.43.glb
# URL pública opcional del bucket (p. ej. https://pub-xxxx.r2.dev)
R2_PUBLIC_URL_BASE=

# ---------------- [ Gestión de Cuentas / dPaaS ] ----------------
# Master key (32 bytes base64) para cifrar secretos de cuentas en reposo.
# Genera: openssl rand -base64 32
ACCOUNTS_MASTER_KEY=

# ---------------- [ Fase 3 — Gateway 402 reactivo ] ----------------
# Rutas protegidas por micro-peaje (separadas por coma, matching exacto).
# Ej: X402_PROTECTED_PATHS=/api/device,/api/navbar
X402_PROTECTED_PATHS=
# Precio (lamports) de un acceso a una ruta protegida.
X402_PATH_LAMPORTS=1000

# ---------------- [ F5: la APP del ecosistema + voz + peajes ] -------
# La app (Payload CMS u otra) — el AGENTE paga un peaje x402 por CADA
# petición a ella (POST /api/app/request → 402 → dPaaS → reintento).
PAYLOAD_URL=http://localhost:3100
# Login automático de la app (JWT cacheado); o token fijo con PAYLOAD_TOKEN
PAYLOAD_EMAIL=
PAYLOAD_PASSWORD=
PAYLOAD_TOKEN=
# Orquestador (voz): POST /api/voice → {BRAIN_URL}/v1/agentic-gateway
BRAIN_URL=http://localhost:8322
# Peaje por petición del agente a la app (lamports)
X402_APP_LAMPORTS=1000
# Peaje por minuto de llamada (lamports)
X402_CALL_LAMPORTS=

# ---------------- [ W6: faucet Devnet — settlement real ] ------------
# Treasury devnet que gotea SOL a las wallets dPaaS de las cuentas
# (POST /api/dev/faucet + botón 💧 del panel). Fundear con
# scripts/faucet/faucet.sh fund (o faucet.solana.com).
FAUCET_ENABLED=1
FAUCET_KEYPAIR=scripts/faucet/nomikos-treasury.json
FAUCET_LAMPORTS=50000000

# Key NIM de las CUENTAS (provider nvidia-nim; la comparte el brain vía
# contexto). La MISMA key sirve para Llama Stack (ver brain/.env).
NVIDIA_API_KEY=

# ---------------- [ Cloudflare API (tokens generales) ] ----------------
# Alternativa a las claves R2 de arriba (dash.cloudflare.com → My Profile
# → API Tokens). Vacío = no se usan.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
CLOUDFLARE_API_TOKEN=

# ---------------- [ Verificador legal S2 (workshop) ] ----------------
# Solo el proceso api lee VERIFIER_GT_DIR (0600). Brain/dapp/ui jamás.
VERIFIER_ENABLED=1
VERIFIER_GT_DIR=../ground_truth
VERIFIER_CASES_DIR=../cases
VERIFIER_UI_PORT=8765
VERIFIER_WORLD_TOKEN=
